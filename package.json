{
    "name": "@bejibun/limiter",
    "version": "0.1.1",
    "author": "Havea Crenata <havea.crenata@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Bejibun-Framework/bejibun-limiter.git"
    },
    "main": "index.js",
    "module": "index.js",
    "dependencies": {
        "@bejibun/app": "^0.1.24",
        "@bejibun/cache": "^0.1.24",
        "@bejibun/logger": "^0.1.22",
        "@bejibun/utils": "^0.1.28"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "tsc-alias": "^1.9.1"
    },
    "bugs": {
        "url": "https://github.com/Bejibun-Framework/bejibun-limiter/issues"
    },
    "description": "Limiter for Bejibun Framework",
    "homepage": "https://github.com/Bejibun-Framework/bejibun-limiter#readme",
    "keywords": [
        "bun",
        "bun framework",
        "limiter",
        "bejibun",
        "typescript"
    ],
    "license": "MIT",
    "scripts": {
        "alias": "bunx tsc-alias -p tsconfig.json",
        "rsync": "rsync -a dist/ ./",
        "clean": "rm -rf dist",
        "build": "bunx tsc -p tsconfig.json && bun run alias && bun run rsync && bun run clean",
        "deploy": "bun run build && bun publish --access public"
    },
    "type": "module",
    "types": "index.d.ts"
}